# Copy to .env and fill in. Never commit .env.

# ── Groq (one key covers both speech-to-text and the LLM) ────────────────
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Optional fallbacks (leave blank to skip them) ────────────────────────
SARVAM_API_KEY=
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Provider order: first one that works wins; providers without a key are skipped ──
# ASR_ORDER=groq,sarvam,whisper
# LLM_ORDER=groq,gemini,qwen
# Groq only:   ASR_ORDER=groq   LLM_ORDER=groq
# Local fallbacks (whisper = faster-whisper on CPU, qwen = Ollama) need no key.

# ── Optional model overrides ─────────────────────────────────────────────
# GROQ_ASR_MODEL=whisper-large-v3        # or whisper-large-v3-turbo
# GROQ_MODEL=llama-3.3-70b-versatile     # or openai/gpt-oss-120b, openai/gpt-oss-20b
# GROQ_CHUNK_SECONDS=600
# GEMINI_MODEL=gemini-2.5-flash
# SARVAM_MODEL=saaras:v3
# SARVAM_MODE=translit
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
