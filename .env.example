# ── ASR ─────────────────────────────────────────────────────────────────────
# Provider chain: tried left→right, first working one wins
# Options: groq, sarvam, whisper
ASR_ORDER=groq,sarvam,whisper

# Groq — one key covers both ASR (Whisper-large-v3) and LLM (Llama/Mixtral)
# Get your key: https://console.groq.com
GROQ_API_KEY=

# Sarvam — best for Indian languages (Hindi, Kannada, Tamil…)
# Get your key: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ── LLM ─────────────────────────────────────────────────────────────────────
# Provider chain: groq, gemini, qwen (local Ollama)
LLM_ORDER=groq,gemini,qwen

GEMINI_API_KEY=

# Ollama — for local GPU inference (tunnelled via Cloudflare to Railway)
# In production, set this to your cloudflared public URL, e.g.:
#   OLLAMA_BASE_URL=https://llm.your-domain.workers.dev
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CONFIDENCE_THRESHOLD=0.70
MAX_AUDIO_SIZE_MB=50

# CORS: comma-separated list of allowed frontend origins (Railway env var)
# e.g. https://medroute.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
