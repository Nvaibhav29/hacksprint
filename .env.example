# ── Groq (ASR + LLM) ────────────────────────────────────────────────────────
# One key covers both speech-to-text (Whisper-large-v3) and LLM (Llama/Scout)
# Get your key: https://console.groq.com
GROQ_API_KEY=

# ── Local Whisper fallback (used when GROQ_API_KEY is empty) ─────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Laptop ASR through a tunnel (asr_server.py + start-asr.ps1) ──────────────
# Same ASR_TOKEN on the laptop (.env) and on Railway. Make it long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ASR_TOKEN=
# Railway only: public address of the tunnel, no trailing slash. Leave empty to disable.
ASR_REMOTE_URL=
ASR_REMOTE_TIMEOUT_SECONDS=300
# Laptop only
ASR_SERVER_PORT=8001
ASR_SERVER_OLLAMA_URL=http://localhost:11434

# ── Local Ollama / Qwen fallback (used when GROQ_API_KEY is empty) ───────────
# In production with Cloudflare tunnel set this to your public tunnel URL:
#   OLLAMA_BASE_URL=https://xxxx.trycloudflare.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...

# ── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CONFIDENCE_THRESHOLD=0.70
MAX_AUDIO_SIZE_MB=50

# CORS: comma-separated allowed frontend origins (set on Railway dashboard)
#   e.g. https://medroute.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
